{
  "name": "dicer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node tools/build-assets.mjs",
    "fonts": "node tools/build-fonts.mjs",
    "icons": "node tools/build-icons.mjs",
    "verify": "npm run verify:values && npm run verify:reading && npm run verify:camera && npm run verify:physics",
    "verify:values": "node tools/verify-values.mjs",
    "verify:reading": "node tools/verify-runtime.mjs",
    "verify:camera": "node tools/verify-camera.mjs",
    "verify:tray": "node tools/verify-tray.mjs",
    "verify:layout": "node tools/verify-layout.mjs",
    "verify:physics": "node tools/verify-physics.mjs --trials 240",
    "verify:pairs": "node tools/verify-physics.mjs --pairs 1200",
    "verify:audio": "node tools/verify-audio.mjs",
    "verify:sound": "node tools/verify-sound.mjs",
    "sound:reference": "node tools/sound-reference.mjs",
    "sound:spectrogram": "node tools/sound-spectrogram.mjs",
    "verify:build": "node tools/verify-build.mjs",
    "verify:flakes": "node tools/verify-flakes.mjs",
    "verify:pwa": "node tools/verify-pwa.mjs",
    "calibrate": "node tools/calibrate.mjs --set set7 --mode face --zoom 0.62",
    "flakes": "node tools/flake-sheet.mjs",
    "face-sheets": "node tools/face-sheets.mjs",
    "shoot": "node tools/shoot.mjs",
    "diagnose": "node tools/diagnose.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-pwa": "^1.3.0"
  }
}
